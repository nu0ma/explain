{
  "name": "explain-cli",
  "version": "0.3.0",
  "private": true,
  "description": "Markdown の原稿から 1 ファイルの解説 HTML と解説動画を作る、日本語専用の CLI",
  "type": "module",
  "bin": {
    "explain": "bin/explain.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
