{
  "name": "explain-cli",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "A CLI that turns a Markdown script into a single-file explainer HTML page and an explainer video (Japanese output)",
  "type": "module",
  "bin": {
    "explain": "bin/explain.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
