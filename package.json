{
  "name": "explain",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "A CLI that turns a Markdown script into a single-file explainer HTML page and an explainer video (Japanese output)",
  "type": "module",
  "bin": {
    "explain": "bin/explain.ts"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=24.21"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "oxlint",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.ts\""
  },
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  }
}
